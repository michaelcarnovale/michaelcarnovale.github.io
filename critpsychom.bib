@Article{Tryon1996,
  author    = {Warren W. Tryon},
  journal   = {The Journal of Mind and Behavior},
  title     = {Measurement Units and Theory Construction},
  year      = {1996},
  issn      = {02710137},
  number    = {3},
  pages     = {213--227},
  volume    = {17},
  abstract  = {The central thesis of this article is that measurement units are theoretical concepts because measurement presumes theoretical definition. New theoretical constructs can be defined in terms of algebraic combinations of previously defined measurement units. Physics has developed an impressive hierarchical knowledge structure on this basis. The unitless measures favored by psychology preclude the generation of such a knowledge hierarchy. It also leads to definitions of reliability and validity in correlational terms which can result in inaccurate measurement. Psychology has long used time as a fundamental unit. Adoption of a second measurement unit would enable construction of a psychological knowledge hierarchy to begin.},
  publisher = {Institute of Mind and Behavior, Inc.},
  url       = {http://www.jstor.org/stable/43854138},
  urldate   = {2026-08-17},
}

@Article{Loeker1999,
  author    = {Altan Löker},
  journal   = {The Journal of Mind and Behavior},
  title     = {Theory in Psychology: A Reply to Tryon's "Measurement Units and Theory Construction"},
  year      = {1999},
  issn      = {02710137},
  number    = {3},
  pages     = {277--294},
  volume    = {20},
  abstract  = {Tryon advises psychologists to construct theories as physicists do, and claims that a theory of physics is a system of algebraic relations which constitute the definitions of new concepts and their units of measurement in terms of existing ones, at least two basic units being initially adopted. He says that these algebraic relations create a knowledge hierarchy, which he considers a theory. In reality, only some of the mathematical relations of physics are definitions, which introduce new tools, while the rest of them express the "laws of nature," the discovery of which is the primary objective of science. Tryon also says that these algebraic relations express quantitative, logical, and conceptual equivalences. He is wrong again, because only the relations that constitute definitions express conceptual equivalences, while the laws of nature are discovered either by making measurements or by constructing theories. Tryon says nothing about the discovery of the laws of nature either way, and appears to consider the concept of "law of nature" as unscientific. He also believes that measurements serve only to determine the characteristic properties of substances. In this article, the usefulness of the concept of "law of nature" is illustrated, and more importantly, the method of theory construction used in physics and the way in which it can be adapted to psychology are explained.},
  publisher = {Institute of Mind and Behavior, Inc.},
  url       = {http://www.jstor.org/stable/43853893},
  urldate   = {2026-08-17},
}

@Article{Tryon1999,
  author    = {Warren W. Tryon},
  journal   = {The Journal of Mind and Behavior},
  title     = {Measurement Units and Theory Construction: A Reply to Löker's "Theory in Psychology"},
  year      = {1999},
  issn      = {02710137},
  number    = {3},
  pages     = {295--298},
  volume    = {20},
  abstract  = {Tryon's (1996) primary thesis and four corollary points are restated. Seven of Löker's primary criticisms are identified and rebutted. It is concluded that measurement units are theoretical entities because they concern the quanta being measured and that these entities can be combined in various ways to generate new theoretical concepts.},
  publisher = {Institute of Mind and Behavior, Inc.},
  url       = {http://www.jstor.org/stable/43853894},
  urldate   = {2026-08-17},
}

@Article{Loeker1999a,
  author    = {Altan Löker},
  journal   = {The Journal of Mind and Behavior},
  title     = {A Reply to Tryon's: "A Reply to Löker's 'Theory in Psychology'"},
  year      = {1999},
  issn      = {02710137},
  number    = {3},
  pages     = {299--310},
  volume    = {20},
  abstract  = {Tryon's (1999) reply to Löker's (1999) criticisms of Tryon's (1996) "Measurement Units and Theory Construction" necessitates clarification at several points and the correction of the errors it contains. Tryon appears to have changed some of his positions, perhaps being influenced by my (Löker, 1999) criticisms, but he still ignores how theories are constructed. Tryon even states that my explanations of how theories are constructed in physics and how they can be constructed in psychology are outside the scope of his article, despite the fact that the title, main topic, and the conclusion of his original article concern theory construction in psychology which is the reason, no doubt, why his article was published in a psychology journal. His mistakes about, and distortions of, my ideas and also his distortions of his own earlier (Tryon, 1996) statements are exposed and corrected in the present article.},
  publisher = {Institute of Mind and Behavior, Inc.},
  url       = {http://www.jstor.org/stable/43853895},
  urldate   = {2026-08-17},
}

 
